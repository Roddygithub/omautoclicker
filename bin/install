#!/bin/bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
id=roddy.omautocliker
dest="$HOME/.config/omarchy/plugins/$id"
omarchy plugin validate "$root"
updating=false
if [[ -d "$dest" ]]; then
  updating=true
  backup="${XDG_STATE_HOME:-$HOME/.local/state}/omautocliker/backups/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$(dirname "$backup")"
  cp -a "$dest" "$backup"
  omarchy-shell omautocliker stop || true
fi
mkdir -p "$dest/i18n"
install -m644 "$root/manifest.json" "$root/Service.qml" "$root/BarWidget.qml" \
  "$root/MouseMark.qml" "$root/ClickPanel.qml" "$root/Model.js" "$root/LICENSE" "$root/README.md" "$dest/"
install -m644 "$root"/i18n/*.json "$dest/i18n/"
omarchy plugin validate "$dest"
if "$updating"; then
  # A shell restart clears QML's component cache after a local code update.
  if ! omarchy restart shell; then echo 'Waiting for the restarted shell to finish loading.' >&2; fi
else
  # Discovery can close the IPC socket while the reload is already in flight.
  if ! omarchy-shell shell rescanPlugins; then echo 'Waiting for plugin discovery.' >&2; fi
fi
for ((attempt = 0; attempt < 40; attempt++)); do
  if omarchy plugin list --json | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null; then
    omarchy plugin enable "$id" --section right
    printf 'Installed %s. See README.md for ydotoold and F8/F9 setup.\n' "$id"
    exit 0
  fi
  sleep 0.2
done
echo 'The shell did not discover the plugin; inspect its logs before retrying.' >&2
exit 1
